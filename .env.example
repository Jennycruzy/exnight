# Bitget API credentials (Settings -> API Management). Read permission is enough for research.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Optional Qwen confounder analyst; never used for trading decisions
BITGET_QWEN_API_KEY=
# Bitget hackathon Qwen proxy (must retain the /v1 suffix)
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
