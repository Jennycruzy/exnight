# Bitget API credentials (Settings -> API Management). Read permission is enough for research.
# The guarded --live path requires a funded mainnet UTA trade key; demo keys must not be
# pointed at the mainnet endpoint and Bitget demo mode does not accept Reality order symbols.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Optional absolute path to the official Agent Hub CLI; cron can use this when NVM is not in PATH.
# AGENT_HUB_BIN=/home/ubuntu/.nvm/versions/node/v24.21.0/bin/bgc
# Optional Qwen confounder analyst; never used for trading decisions
BITGET_QWEN_API_KEY=
# Bitget hackathon Qwen proxy (must retain the /v1 suffix)
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
